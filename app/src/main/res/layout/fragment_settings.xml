<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <TextView
        android:id="@+id/textView"
        style="@style/TextViewStyleH1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="Настройки"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@+id/textView">

        <ImageView
            android:id="@+id/iv_user_photo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginStart="5dp"
            android:src="@drawable/ic_avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_semi_bold"
                android:text="Name"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_regular"
                android:text="email"
                android:textColor="@color/gray"
                android:textSize="18sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="180dp"
            android:background="@android:color/transparent"
            android:padding="0dp"
            app:icon="@drawable/ic_arrow_right"
            app:iconTint="@color/black" />
    </LinearLayout>

    <ImageView
        android:id="@+id/imageView1"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="5dp"
        android:src="@drawable/img_bookings"
        app:layout_constraintBottom_toBottomOf="@+id/btn_bookings"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_bookings" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_bookings"
        style="@style/TextViewStyleSettingsElements"
        android:layout_width="match_parrent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:layout_marginTop="30dp"
        android:paddingStart="5dp"
        android:paddingTop="10dp"
        android:paddingBottom="2dp"
        android:text="Мои бронирования"
        app:backgroundTint="@android:color/transparent"
        app:cornerRadius="0dp"
        app:icon="@drawable/ic_arrow_right"
        app:iconGravity="end"
        app:iconTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageView1"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout3" />


    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="5dp"
        android:src="@drawable/img_theme"
        app:layout_constraintBottom_toBottomOf="@+id/btn_theme"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_theme" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_theme"
        style="@style/TextViewStyleSettingsElements"
        android:layout_width="match_parrent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:layout_marginTop="5dp"
        android:paddingStart="5dp"
        android:paddingTop="10dp"
        android:paddingBottom="2dp"
        android:text="Тема"
        app:backgroundTint="@android:color/transparent"
        app:cornerRadius="0dp"
        app:icon="@drawable/ic_arrow_right"
        app:iconGravity="end"
        app:iconTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageView2"
        app:layout_constraintTop_toBottomOf="@+id/btn_bookings" />

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="5dp"
        android:src="@drawable/img_notifications"
        app:layout_constraintBottom_toBottomOf="@+id/btn_notices"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_notices" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_notices"
        style="@style/TextViewStyleSettingsElements"
        android:layout_width="match_parrent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:layout_marginTop="5dp"
        android:paddingStart="5dp"
        android:paddingTop="10dp"
        android:paddingBottom="2dp"
        android:text="Уведомления"
        app:backgroundTint="@android:color/transparent"
        app:cornerRadius="0dp"
        app:icon="@drawable/ic_arrow_right"
        app:iconGravity="end"
        app:iconTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageView3"
        app:layout_constraintTop_toBottomOf="@+id/btn_theme" />

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="5dp"
        android:src="@drawable/img_connect"
        app:layout_constraintBottom_toBottomOf="@+id/btn_connect"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_connect" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_connect"
        style="@style/TextViewStyleSettingsElements"
        android:layout_width="match_parrent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:layout_marginTop="5dp"
        android:paddingStart="5dp"
        android:paddingTop="10dp"
        android:paddingBottom="2dp"
        android:text="Подключить свой автомобиль"
        app:backgroundTint="@android:color/transparent"
        app:cornerRadius="0dp"
        app:icon="@drawable/ic_arrow_right"
        app:iconGravity="end"
        app:iconTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageView4"
        app:layout_constraintTop_toBottomOf="@+id/btn_notices" />

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="5dp"
        android:src="@drawable/img_help"
        app:layout_constraintBottom_toBottomOf="@+id/btn_help"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_help" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_help"
        style="@style/TextViewStyleSettingsElements"
        android:layout_width="match_parrent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:layout_marginTop="5dp"
        android:paddingStart="5dp"
        android:paddingTop="10dp"
        android:paddingBottom="2dp"
        android:text="Помощь"
        app:backgroundTint="@android:color/transparent"
        app:cornerRadius="0dp"
        app:icon="@drawable/ic_arrow_right"
        app:iconGravity="end"
        app:iconTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageView5"
        app:layout_constraintTop_toBottomOf="@+id/btn_connect" />


    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="5dp"
        android:src="@drawable/img_invite"
        app:layout_constraintBottom_toBottomOf="@+id/btn_invite"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_invite" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_invite"
        style="@style/TextViewStyleSettingsElements"
        android:layout_width="match_parrent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:paddingStart="5dp"
        android:layout_marginTop="5dp"
        android:paddingTop="10dp"
        android:paddingBottom="2dp"
        android:text="Пригласи друга"
        app:backgroundTint="@android:color/transparent"
        app:cornerRadius="0dp"
        app:icon="@drawable/ic_arrow_right"
        app:iconGravity="end"
        app:iconTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageView6"
        app:layout_constraintTop_toBottomOf="@+id/btn_help" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parrent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="30dp">

        <ImageButton
            android:id="@+id/btn_main"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/img_home"
            android:layout_marginStart="60dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <ImageButton
            android:id="@+id/btn_profile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/img_favorites"
            app:layout_constraintEnd_toStartOf="@+id/btn_settings"
            app:layout_constraintStart_toEndOf="@+id/btn_main"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="60dp"
            android:src="@drawable/img_settings"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>