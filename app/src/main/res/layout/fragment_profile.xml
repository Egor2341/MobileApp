<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_profile"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.settings.ProfileFragment"
    android:background="@color/white">

    <TextView
        android:id="@+id/tw_title"
        style="@style/TextViewStyleSettingsLabels"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="Профиль"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_photo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tw_title">

        <ImageView
            android:id="@+id/iv_user_photo"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:src="@drawable/ic_avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btn_add_user_photo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:src="@drawable/ic_add_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/iv_user_photo" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tw_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_semi_bold"
        android:layout_marginTop="10dp"
        android:textSize="20sp"
        android:textColor="@color/black"
        android:text="Name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_photo" />

    <TextView
        android:id="@+id/tw_created_at"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_regular"
        android:text="CreatedAt"
        android:textColor="@color/text_color"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.501"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tw_name" />

    <TextView
        android:id="@+id/tw_email_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextViewStyleMedium"
        android:text="Электронная почта"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tw_created_at" />

    <TextView
        android:id="@+id/tw_email_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextViewStyleH2Gray"
        android:text="email@example.com"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tw_email_label"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D0D5DD"
        app:layout_constraintTop_toBottomOf="@id/tw_email_value"/>

    <TextView
        android:id="@+id/tw_password_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextViewStyleMedium"
        android:text="Пароль"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tw_email_value" />

    <TextView
        android:id="@+id/tw_password_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextViewStyleH2Gray"
        android:text="Поменять пароль"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tw_password_label"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D0D5DD"
        app:layout_constraintTop_toBottomOf="@id/tw_password_value"/>

    <TextView
        android:id="@+id/tw_gender_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextViewStyleMedium"
        android:text="Пол"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tw_password_value" />

    <TextView
        android:id="@+id/tw_gender_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextViewStyleH2Gray"
        android:text=""
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tw_gender_label"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D0D5DD"
        app:layout_constraintTop_toBottomOf="@id/tw_gender_value"/>

    <TextView
        android:id="@+id/tw_google_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextViewStyleMedium"
        android:text="Google"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tw_gender_value" />

    <TextView
        android:id="@+id/tw_google_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextViewStyleH2Gray"
        android:text=""
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tw_google_label"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D0D5DD"
        app:layout_constraintTop_toBottomOf="@id/tw_google_value"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_sign_out"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        app:cornerRadius="0dp"
        style="@style/TextViewStyleMedium"
        android:text="Выйти из профиля"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tw_google_value" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bnvMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:itemIconSize="30dp"
        app:menu="@menu/menu"
        >

    </com.google.android.material.bottomnavigation.BottomNavigationView>



</androidx.constraintlayout.widget.ConstraintLayout>